# Пример переменных окружения для /opt/netbox-wiki/.env
# Скопируйте: cp templates/env.example /opt/netbox-wiki/.env
# Затем замените все CHANGE_ME. Права: chmod 600 .env
#
# Полная ручная инструкция: ../MANUAL.md
# Автоустановка генерирует этот файл сама: ../install.sh

# --- хост и внешние порты (публикует контейнер nginx) ---
INSTALL_HOST=example.local
ALLOWED_HOSTS=*
NETBOX_HTTPS_PORT=443
MEDIAWIKI_HTTPS_PORT=8443

# --- теги образов ---
NETBOX_IMAGE_TAG=v3.7.8
MEDIAWIKI_IMAGE_TAG=1.39.11

# --- PostgreSQL (volume netbox-postgres → /var/lib/postgresql/data) ---
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=CHANGE_ME

# --- NetBox (суперпользователь создаётся при первом старте контейнера) ---
NETBOX_SECRET_KEY=CHANGE_ME
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.local
NETBOX_SUPERUSER_PASSWORD=CHANGE_ME

# --- MariaDB для wiki (volume mediawiki-mysql → /var/lib/mysql) ---
WIKI_NAME=CorpWiki
WIKI_DB_NAME=mediawiki
WIKI_DB_USER=wiki
WIKI_DB_PASSWORD=CHANGE_ME
WIKI_DB_ROOT_PASSWORD=CHANGE_ME

# --- админ MediaWiki (используется в maintenance/install.php вручную) ---
WIKI_ADMIN_USER=WikiAdmin
WIKI_ADMIN_PASSWORD=CHANGE_ME
