[RedOS8-Archive-Base-local]
name=Local RED OS 8 Base ARCHIVE (old packages)
baseurl=https://repo.example.ru/archive/redos8/redos8_base_src/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-RED-SOFT
sslverify=1
enabled=0
# Включать только когда нужна старая версия:
#   dnf install PKG --enablerepo=RedOS8-Archive-Base-local
